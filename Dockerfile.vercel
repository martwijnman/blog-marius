# syntax=docker/dockerfile:1

FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && printf '%s\n' \
        'upload_max_filesize = 12M' \
        'post_max_size = 16M' \
        'memory_limit = 256M' \
        > "$PHP_INI_DIR/conf.d/zz-uploads.ini" \
    && install-php-extensions \
        intl \
        zip \
        opcache \
        pcntl \
        pdo_pgsql \
        pdo_mysql \
        pdo_sqlite

WORKDIR /app


# ---------- BUILD ----------
FROM base AS build

# vite.config.ts gebruikt dit om wayfinder over te slaan tijdens de build,
# zodat er geen booted Laravel-app (en dus geen APP_KEY/.env) nodig is.
ENV VERCEL=1

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Node 22, zonder FrankenPHP's eigen binaries in /usr/local te overschrijven
COPY --from=node:22-bookworm /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm

# PHP-dependencies (zonder scripts: artisan bestaat hier nog niet)
COPY composer.json composer.lock ./
RUN composer install \
        --no-dev \
        --no-scripts \
        --no-autoloader \
        --no-interaction \
        --no-progress \
        --prefer-dist

# Node-dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Applicatiecode
COPY . .

RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache

RUN composer dump-autoload --no-dev --optimize --classmap-authoritative

# Vite/React build. Wayfinder wordt overgeslagen als VERCEL gezet is
# (zie vite.config.ts); de gegenereerde routes staan in git.
RUN npm run build

# SQLite-database in de image bouwen.
# database/database.sqlite staat in .gitignore en .dockerignore, dus zonder
# deze stap bestaat het bestand niet in de container en crasht elke request
# met een 500 zodra Laravel de session/cache store opent.
#
# Deze env-waarden gelden ALLEEN in de build-stage; de runtime-stage begint
# opnieuw vanaf `base` en gebruikt de env vars uit Vercel.
ENV APP_ENV=production \
    APP_DEBUG=false \
    APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/database.sqlite \
    SESSION_DRIVER=file \
    CACHE_STORE=file \
    QUEUE_CONNECTION=sync \
    LOG_CHANNEL=stderr

# Fallback-APP_KEY voor als de env var op Vercel leeg is (zie config/app.php).
RUN php -r 'file_put_contents("/app/.deploy-key", "base64:".base64_encode(random_bytes(32)));'

# DatabaseSeeder is Faker-vrij gemaakt zodat hij ook in deze --no-dev build
# kan draaien: categorieen plus het testaccount.
RUN mkdir -p database \
    && touch database/database.sqlite \
    && php artisan migrate --force \
    && php artisan db:seed --force

# public/storage -> storage/app/public, anders geeft elke ge-uploade
# afbeelding een 404.
RUN php artisan storage:link --force


# ---------- RUNTIME ----------
FROM base AS runtime

# Blade compileert views naar view.compiled. Zonder config/view.php is dat
# realpath(storage_path('framework/views')), en dat pad is in deze container
# niet betrouwbaar schrijfbaar: de gecompileerde app.blade.php stond er wel,
# maar het inline-component bestand van <x-inertia::head> niet - vandaar
# 'View [<hash>] not found' op elke pagina. Een eigen map onder /tmp is per
# instance altijd schrijfbaar, en Blade bouwt de cache daar zelf opnieuw op.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    VIEW_COMPILED_PATH=/tmp/views \
    LOG_CHANNEL=stderr

COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile
COPY --chown=www-data:www-data vercel-entrypoint.sh /usr/local/bin/vercel-entrypoint.sh
COPY --from=build --chown=www-data:www-data /app /app

RUN chmod +x /usr/local/bin/vercel-entrypoint.sh \
    && mkdir -p /tmp/views \
    && chown www-data:www-data /tmp/views \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy /app/storage /app/bootstrap/cache /app/database

USER www-data

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/vercel-entrypoint.sh"]

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
